<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_canvas" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingTop="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical" android:letterSpacing="0.01" android:text="@string/settings" android:textColor="@color/ink" android:textSize="27sp" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/settingsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_panel" android:paddingHorizontal="6dp" android:paddingVertical="4dp" />
    <FrameLayout
        android:id="@+id/tabNativeAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />
</LinearLayout>
