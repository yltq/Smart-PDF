<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_sheet_handle" />

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_danger_icon"
        android:contentDescription="@null"
        android:padding="14dp"
        android:src="@drawable/ic_delete" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/delete_file_title"
        android:textColor="@color/ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/delete_file_message"
        android:textColor="@color/ink_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancelDelete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center"
            android:stateListAnimator="@animator/press_scale"
            android:text="@string/cancel"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmDelete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:stateListAnimator="@animator/press_scale"
            android:text="@string/delete"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
