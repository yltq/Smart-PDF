<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/documentRoot"
    android:layout_width="match_parent" android:layout_height="82dp" android:background="@drawable/bg_list_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp">
    <ImageView android:id="@+id/documentIcon" android:layout_width="32dp" android:layout_height="40dp" android:contentDescription="@null" android:scaleType="centerInside" />
    <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="12dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/documentName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/documentSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/ink_secondary" android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/selectionIndicator" android:layout_width="48dp" android:layout_height="58dp" android:contentDescription="@string/select_document" android:padding="12dp" android:scaleType="centerInside" android:visibility="gone" />
    <ImageView android:id="@+id/dragHandle" android:layout_width="40dp" android:layout_height="58dp" android:contentDescription="@string/reorder_document" android:padding="10dp" android:src="@drawable/ic_drag_handle" android:visibility="gone" />
    <ImageView android:id="@+id/favoriteButton" android:layout_width="44dp" android:layout_height="58dp" android:contentDescription="@string/collection" android:padding="10dp" android:scaleType="centerInside" />
    <TextView android:id="@+id/moreButton" android:layout_width="40dp" android:layout_height="58dp" android:contentDescription="@string/more_options" android:gravity="center" android:text="⋮" android:textColor="@color/ink" android:textSize="26sp" />
</LinearLayout>
