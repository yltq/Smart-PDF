<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_list_row" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:stateListAnimator="@animator/press_scale">
    <TextView android:id="@+id/languageName" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:textColor="@color/ink" android:textSize="16sp" />
    <RadioButton android:id="@+id/languageRadio" android:layout_width="48dp" android:layout_height="match_parent" android:clickable="false" android:buttonTint="@color/brand_red" />
</LinearLayout>
