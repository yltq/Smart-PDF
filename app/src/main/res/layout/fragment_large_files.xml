<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_canvas"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <LinearLayout
        android:id="@+id/filterGroup"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_large_file_filter_group"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="2dp">

        <TextView
            android:id="@+id/sizeFilter"
            style="@style/LargeFileFilter"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/typeFilter"
            style="@style/LargeFileFilter"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/dateFilter"
            style="@style/LargeFileFilter"
            android:layout_width="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/largeFileSummary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/largeFileSummaryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/largeFileSummaryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectAllAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@animator/press_scale"
            android:textColor="@color/brand_red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/largeFileContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/largeFileList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel"
            android:clipToPadding="false"
            android:paddingStart="5dp"
            android:paddingTop="4dp"
            android:paddingEnd="5dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:id="@+id/largeFileEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/largeFileStateImage"
                android:layout_width="196dp"
                android:layout_height="136dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/state_no_files" />

            <TextView
                android:id="@+id/largeFileStateTitle"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/largeFileStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/largeFileStateAction"
                android:layout_width="176dp"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:stateListAnimator="@animator/press_scale"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/largeFileLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/brand_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/large_files_scanning"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/largeFileBottomBar"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:background="@color/app_canvas"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/cleanLargeFiles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_primary_button"
            android:enabled="false"
            android:gravity="center"
            android:stateListAnimator="@animator/press_scale"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
