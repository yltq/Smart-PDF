<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_canvas"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sizeFilter"
                style="@style/LargeFileFilter"
                app:drawableEndCompat="@drawable/ic_chevron_down" />

            <TextView
                android:id="@+id/typeFilter"
                style="@style/LargeFileFilter"
                app:drawableEndCompat="@drawable/ic_chevron_down" />

            <TextView
                android:id="@+id/dateFilter"
                style="@style/LargeFileFilter"
                app:drawableEndCompat="@drawable/ic_chevron_down" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/largeFileSummary"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_large_file_summary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_large_file_icon"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_large_file"
            app:tint="@color/brand_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/largeFileSummaryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/largeFileSummaryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectAllAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="10dp"
            android:stateListAnimator="@animator/press_scale"
            android:textColor="@color/brand_red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/largeFileList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel"
            android:clipToPadding="false"
            android:paddingHorizontal="5dp"
            android:paddingVertical="5dp" />

        <LinearLayout
            android:id="@+id/largeFileEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_large_file_empty_icon"
                android:contentDescription="@null"
                android:padding="18dp"
                android:src="@drawable/ic_large_file"
                app:tint="@color/brand_red" />

            <TextView
                android:id="@+id/largeFileStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/largeFileStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/largeFileStateAction"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:minWidth="164dp"
                android:paddingHorizontal="22dp"
                android:stateListAnimator="@animator/press_scale"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/largeFileLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminateTint="@color/brand_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/large_files_scanning"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/largeFileBottomBar"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@color/app_canvas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectedLargeFileSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cleanLargeFiles"
            android:layout_width="154dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_primary_button"
            android:enabled="false"
            android:gravity="center"
            android:stateListAnimator="@animator/press_scale"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
