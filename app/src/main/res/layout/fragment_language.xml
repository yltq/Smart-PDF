<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/app_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_toolbar" android:gravity="center_vertical" android:paddingHorizontal="4dp">
        <ImageView android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/back" android:padding="12dp" android:src="@drawable/ic_back" android:stateListAnimator="@animator/press_scale" />
        <TextView android:id="@+id/toolbarTitle" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
        <Space android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/languageList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginEnd="16dp" android:layout_weight="1" android:background="@drawable/bg_panel" android:clipToPadding="false" android:paddingHorizontal="6dp" android:paddingVertical="4dp" />
    <FrameLayout
        android:id="@+id/languageNativeAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp" />
    <TextView android:id="@+id/applyLanguage" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="18dp"
        android:background="@drawable/bg_primary_button" android:gravity="center" android:stateListAnimator="@animator/press_scale" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
