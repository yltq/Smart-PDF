<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_canvas"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingBottom="18dp">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <TextView
        android:id="@+id/scanHint"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:textColor="@color/ink_secondary"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scanPages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/createScanPdf"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_primary_button"
        android:elevation="3dp"
        android:gravity="center"
        android:stateListAnimator="@animator/press_scale"
        android:text="@string/create_pdf"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
