<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_canvas"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <LinearLayout
        android:id="@+id/resultContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/resultHero"
            android:layout_width="118dp"
            android:layout_height="132dp"
            android:background="@drawable/bg_result_document_tile"
            android:elevation="2dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_result_document" />

            <TextView
                android:layout_width="58dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_result_pdf_label"
                android:elevation="2dp"
                android:gravity="center"
                android:text="PDF"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:translationY="10dp" />

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_result_check_badge"
                android:contentDescription="@null"
                android:elevation="4dp"
                android:padding="10dp"
                android:src="@drawable/ic_result_check" />
        </FrameLayout>

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/result_ready_description"
            android:textColor="@color/ink_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_result_file_card"
            android:elevation="1dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <include
                android:id="@+id/resultDocument"
                layout="@layout/item_document"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/resultNativeAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/resultActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/openResult"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:stateListAnimator="@animator/press_scale"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_open"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/view_pdf"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/returnHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_result_share_button"
            android:elevation="0dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:stateListAnimator="@animator/press_scale"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/nav_selector_home"
                android:tint="@color/ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/return_to_home"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
