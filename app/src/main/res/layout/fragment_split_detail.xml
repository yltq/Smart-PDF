<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/app_canvas">
    <include android:id="@+id/toolbar" layout="@layout/view_toolbar" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="14dp" android:paddingBottom="12dp" android:text="@string/split_description" android:textColor="@color/ink_secondary" android:textSize="14sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pageList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginHorizontal="12dp" android:layout_weight="1" android:background="@drawable/bg_panel" android:clipToPadding="false" android:padding="7dp" />
    <TextView android:id="@+id/splitAction" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="18dp" android:background="@drawable/bg_primary_button" android:enabled="false" android:gravity="center" android:stateListAnimator="@animator/press_scale" android:text="@string/split_selected_pages" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
