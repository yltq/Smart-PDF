<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pageRoot"
    android:layout_width="match_parent" android:layout_height="160dp" android:layout_margin="5dp" android:background="@drawable/bg_card" android:elevation="1dp" android:gravity="center" android:orientation="vertical" android:padding="4dp" android:stateListAnimator="@animator/press_scale">
    <ImageView android:id="@+id/pageImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@null" android:scaleType="fitCenter" />
    <TextView android:id="@+id/pageNumber" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:textColor="@color/ink_secondary" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
