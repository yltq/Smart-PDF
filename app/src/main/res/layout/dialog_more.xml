<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary_card"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="4dp"
        android:paddingBottom="10dp">

        <include
            android:id="@+id/documentHeader"
            layout="@layout/item_document" />

        <TextView
            android:id="@+id/documentPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:drawablePadding="6dp"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/actionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dialog_group"
        android:clipToOutline="true"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/openAction"
                layout="@layout/item_dialog_action" />

            <include
                android:id="@+id/openDivider"
                layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/renameAction"
                layout="@layout/item_dialog_action" />

            <include layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/shareAction"
                layout="@layout/item_dialog_action" />

            <include layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/pdfMergeAction"
                layout="@layout/item_dialog_action" />

            <include
                android:id="@+id/pdfMergeDivider"
                layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/pdfAction"
                layout="@layout/item_dialog_action" />

            <include
                android:id="@+id/pdfDivider"
                layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/pdfPrintAction"
                layout="@layout/item_dialog_action" />

            <include
                android:id="@+id/pdfPrintDivider"
                layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/pdfMarkupAction"
                layout="@layout/item_dialog_action" />

            <include
                android:id="@+id/pdfMarkupDivider"
                layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/pdfOrganizeAction"
                layout="@layout/item_dialog_action" />

            <include
                android:id="@+id/pdfOrganizeDivider"
                layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/pdfWatermarkAction"
                layout="@layout/item_dialog_action" />

            <include
                android:id="@+id/pdfWatermarkDivider"
                layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/infoAction"
                layout="@layout/item_dialog_action" />

            <include layout="@layout/item_dialog_divider" />

            <include
                android:id="@+id/deleteAction"
                layout="@layout/item_dialog_action" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/scrollHint"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="6dp"
        android:src="@drawable/ic_chevron_down"
        android:visibility="gone" />
</LinearLayout>
