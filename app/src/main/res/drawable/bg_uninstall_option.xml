<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/brand_soft" /><stroke android:width="1.5dp" android:color="@color/brand_red" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface_pressed" /><stroke android:width="1dp" android:color="@color/panel_stroke" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/panel_stroke" /><corners android:radius="16dp" /></shape>
    </item>
</selector>
