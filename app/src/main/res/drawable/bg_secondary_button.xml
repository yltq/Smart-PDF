<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#FFF4F5F7" />
            <stroke android:width="1dp" android:color="#FFE8EAEF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="1dp" android:color="#FFD7DAE1" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#FFF8F9FA"
                android:startColor="@color/surface" />
            <stroke android:width="1dp" android:color="#FFDDE0E6" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
