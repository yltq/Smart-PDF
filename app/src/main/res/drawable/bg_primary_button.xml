<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#FFC9CDD4"
                android:startColor="#FFDDE0E5" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#FFB80D15"
                android:startColor="@color/brand_red_dark" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#FFCF1019"
                android:startColor="#FFF33B45" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
